{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SO_BUILD_TESTS": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cpm-cache"
      }
    },
    {
      "name": "mac-universal",
      "hidden": true,
      "inherits": "base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "SO_COPY_PLUGIN": "ON"
      }
    },
    { "name": "mac-universal-debug", "displayName": "macOS universal (Debug)", "inherits": "mac-universal" },
    { "name": "mac-universal-release", "displayName": "macOS universal (Release)", "inherits": "mac-universal" },
    {
      "name": "win-x64",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "win-x64-debug", "displayName": "Windows x64 (Debug)", "inherits": "win-x64" },
    { "name": "win-x64-release", "displayName": "Windows x64 (Release)", "inherits": "win-x64" },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    { "name": "linux-debug", "displayName": "Linux (Debug, CI and dev only)", "inherits": "linux", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-release", "displayName": "Linux (Release, CI and dev only)", "inherits": "linux", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "mac-universal-debug", "configurePreset": "mac-universal-debug", "configuration": "Debug" },
    { "name": "mac-universal-release", "configurePreset": "mac-universal-release", "configuration": "Release" },
    { "name": "win-x64-debug", "configurePreset": "win-x64-debug", "configuration": "Debug" },
    { "name": "win-x64-release", "configurePreset": "win-x64-release", "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    { "name": "mac-universal-debug", "configurePreset": "mac-universal-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "mac-universal-release", "configurePreset": "mac-universal-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "win-x64-debug", "configurePreset": "win-x64-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "win-x64-release", "configurePreset": "win-x64-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } }
  ]
}
