<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Second Opinion @VERSION@</title>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <!-- Keep in step with CMAKE_OSX_DEPLOYMENT_TARGET and the ONNX Runtime minimum (ADR 0009, Q9). -->
    <os-version min="12.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="Installs to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.bermentaudio.secondopinion.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="Installs to /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand and other AU hosts).">
        <pkg-ref id="com.bermentaudio.secondopinion.au"/>
    </choice>
    <choice id="standalone" title="Standalone app" description="Installs Second Opinion.app to /Applications.">
        <pkg-ref id="com.bermentaudio.secondopinion.standalone"/>
    </choice>
    <pkg-ref id="com.bermentaudio.secondopinion.vst3">vst3.pkg</pkg-ref>
    <pkg-ref id="com.bermentaudio.secondopinion.au">au.pkg</pkg-ref>
    <pkg-ref id="com.bermentaudio.secondopinion.standalone">app.pkg</pkg-ref>
</installer-gui-script>
